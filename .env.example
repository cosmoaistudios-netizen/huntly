# Huntly Environment Configuration
# Copy this file to .env and fill in your API credentials (or configure them interactively in Settings via TUI)

# NVIDIA Build NIM API Key (Free tier API credits available at https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# RapidAPI Key for LinkedIn Job Search (Optional)
# Subscribe & generate your key at: https://rapidapi.com/fantastic-jobs-fantastic-jobs-default/api/linkedin-job-search-api
RAPIDAPI_KEY=your_rapidapi_key_here

# OpenRouter API Key (Optional, get at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
